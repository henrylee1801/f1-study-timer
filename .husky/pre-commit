echo '🏗️ Preparing your code for commit...'
echo ''

# Use bun if available (upstream default), otherwise fall back to pnpm.
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
if command -v bun >/dev/null 2>&1; then
    RUN="bun"
else
    RUN="pnpm"
fi

# Auto-format code
echo "📝 Running auto-format... ($RUN)"
$RUN format
echo '✅ Format complete!'
echo ''

# Check Prettier standards
echo '🎨 Checking code formatting...'
$RUN format:check ||
(
    echo ''
    echo '❌ Formatting check failed!'
    echo "📝 Please run \"$RUN format\" to fix styling issues, then try again."
    echo ''
    exit 1
)
echo '✅ Formatting check passed!'
echo ''

# Check ESLint Standards
echo '🔍 Running linter...'
$RUN lint ||
(
    echo ''
    echo '❌ Linting check failed!'
    echo '🔧 Please fix the issues listed above and try committing again.'
    echo ''
    exit 1
)
echo '✅ Linting passed!'
echo ''

# If everything passes... Now we can commit
echo '✨ All checks passed! Committing your changes... ✨'
echo ''
